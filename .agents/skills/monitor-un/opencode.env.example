# OpenCode v2 API access used by monitor.sh to launch the incident agent.
# Copy to /home/eadmin/monitor-un/opencode.env on m49, owned eadmin, chmod 600.
# NEVER commit the real password.
# Password = the m49 OpenCode service pairing password, readable only by entermedia
# from /home/entermedia/.config/opencode/service.json (key "password").
OPENCODE_PORT=49374
OPENCODE_PASSWORD=REPLACE_ME