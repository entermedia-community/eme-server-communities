<!-- EME Chatbot skills: Employee Chat is the real skill; the others are placeholders, not implemented yet -->
<records>
  <data id="employeeChatSkill" bean="employeeChatSkill" agenttype="remoteagent" ordering="10" contextbean="chatMessageContext">
    <name>
      <language id="en"><![CDATA[Employee Chat]]></language>
    </name>
    <markdowncontent><![CDATA[Sends each message in the user's chat to that chat's OpenCode session, which works in the user's own workspace folder (WEB-INF/data/<catalog>/workspaces/<userid>/) with the shell, web and outside-folder access turned off, and shows OpenCode's reply. Each chat session (channel) keeps its own OpenCode session in channel.opencodesessionid. For now the reply arrives whole when OpenCode finishes. Used by Visitor Chat and Employee Chat.]]></markdowncontent>
  </data>
  <data id="emeChatbotHelpDeskSkill" bean="emeChatbotHelpDeskSkill" agenttype="remoteagent" ordering="10" contextbean="chatMessageContext">
