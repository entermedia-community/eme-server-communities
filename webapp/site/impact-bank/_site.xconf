<?xml version="1.0" encoding="UTF-8"?>

<page>
	<property name="editable">true</property>

  	<property name="fallbackdirectory">/community/default</property>

	<property name="catalogid">site/catalog</property>

	<property name="falir">false</property>
	<property name="templatename">impact-bank</property>

	<path-action name="Admin.autoLogin"/>
	<path-action name="MediaArchiveModule.loadApplicationId"/>
	<path-action name="MediaArchiveModule.loadComponentHome"/>
	<path-action name="ProfileModule.loadUserProfile"/>
	<path-action name="MediaArchiveModule.loadModule"/>
	<path-action name="UserProfileModule.loadSideBarWidth"/>
	<path-action name="DesktopModule.loadDesktop"/>
	<path-action name="DataEditModule.loadEditHome"/>
	<path-action name="DataEditModule.loadSearchHome"/>
	<path-action name="MediaArchiveModule.getMediaArchive" alltypes="true" />
	<path-action name="PageValue.loadPageVariable" allowduplicates="true" bean="searcherManager"/>
	<path-action name="PageValue.loadPageVariable" allowduplicates="true" bean="userManager"/>
	<path-action name="SessionValue.loadSessionVariable" bean="moduleManager"/>
	<path-action name="Admin.loadPermissions"/>
	<path-action name="Admin.loadPermissionFinder"/>
	<path-action name="Admin.allowViewing"/>
	<path-action name="TranslationModule.loadBrowserLanguage"/>
	<path-action name="FinderModule.loadAppsMenu"/>
	<path-action name="PageValue.loadPageVariable" allowduplicates="true" bean="inflector"/>
	
	<property name="communitytag">impact-bank</property>
  	<path-action name="MediaAdminModule.loadCommunityTag"/>

	<inner-layout>/site/impact-bank/innerlayout.html</inner-layout>


	<!-- Base Community JS & CSS -->
	<script id="jquery-ui-i18n" cancel="true" src="/${applicationid}/components/javascript/jquery-ui/i18n/jquery-ui-i18n.js"/>
	<script id="jquery-form" src="/${applicationid}/components/javascript/jquery.form.js"/>
	<script id="jquery-validate" src="/${applicationid}/components/javascript/validation/jquery.validate.js"/>
	<script id="validateandedit" src="/${applicationid}/components/javascript/validateandedit.js"/>
	<script id="select2" src="/${applicationid}/components/javascript/select2/js/select2.full.js"/>
	<style id="select2-css" href="/${applicationid}/components/javascript/select2/css/select2.css"/>

	<script id="datetimepicker" src="/site/impact-bank//components/javascript/datepicker/js/bootstrap-datepicker.min.js"/>
	<style id="datetimepicker-css" href="/site/impact-bank//components/javascript/datepicker/css/bootstrap-datepicker3.min.css" />
	<script id="multidate" src="/site/impact-bank//components/javascript/multidate/moment.js"/>

	<script id="liveajax" src="/site/impact-bank//components/javascript/emedia/liveajax.js" />
	<script id="utility-plugins" src="/site/impact-bank//components/javascript/emedia/utility-plugins.js" />

	<script id="runajax" src="/site/impact-bank//components/javascript/emedia/ajax/runajax.js" />
	<script id="emdialog" src="/site/impact-bank//components/javascript/emedia/ajax/emdialog.js" />
	<script id="dataentryfields" src="/${applicationid}/components/javascript/emedia/dataentryfields.js" />
	<script id="ajaxformsubmit" src="/site/impact-bank//components/javascript/emedia/ajax/ajaxformsubmit.js" />

	<script id="videojs" src="/${applicationid}/components/javascript/videojs/8.20.0/video.min.js" defer="true" />
	<script id="videojs-qs" src="/${applicationid}/components/javascript/videojs/8.20.0/videojs-quality-selector.min.js" defer="true" />
	<style id="videojs-css" href="/${applicationid}/components/javascript/videojs/8.20.0/video-js.min.css" />

	<script id="oicomponents" src="/site/impact-bank//components/javascript/oicomponents.js" />
	<script id="openedit" src="/openedit/components/javascript/openedit.js"/>
	<script id="communityglobal" src="/site/impact-bank//components/javascript/community-global.js"/>

	<style id="customfindercolors" href="${finderhome}/theme/defaulttheme/custom.css"/>
	<style id="mediaplayer" href="${finderhome}/theme/styles/pages/mediaplayer.css"/>
	
	<style id="eminstitute" href="/site/impact-bank//theme/css/eminstitute.css"/>
	<style id="oi3" href="/site/impact-bank//theme/css/oi3.css"/>
	<!-- Base Community JS & CSS -->

</page>
